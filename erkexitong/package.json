{
  "name": "erkexitong",
  "version": "0.1.0",
  "private": true,
  "description": "学生综合素质评定系统跨端前端",
  "scripts": {
    "dev:h5": "taro build --type h5 --watch",
    "dev:weapp": "taro build --type weapp --watch",
    "dev:rn": "react-native start",
    "dev:rn:taro": "taro build --type rn --watch",
    "build:h5": "taro build --type h5",
    "build:weapp": "taro build --type weapp",
    "build:rn": "node scripts/ensure-rn-output.js && react-native bundle --platform android --dev false --entry-file index.js --bundle-output dist/rn/android/index.bundle --assets-dest dist/rn/android/assets",
    "build:rn:taro": "taro build --type rn",
    "analyze:h5-size": "node scripts/analyze-h5-size.js",
    "analyze:h5-size:json": "node scripts/analyze-h5-size.js --json dist/h5-size-report.json",
    "compare:h5-size": "node scripts/compare-h5-size.js",
    "check:all": "node scripts/check-all.js",
    "check:builds": "node scripts/check-builds.js",
    "check:core": "node scripts/check-core.js",
    "smoke:h5:run": "node scripts/run-h5-smoke.js",
    "smoke:h5:record": "node scripts/create-h5-smoke-record.js",
    "smoke:h5:finalize": "node scripts/finalize-smoke-record.js --target h5",
    "smoke:h5:results": "node scripts/create-smoke-results-template.js --target h5",
    "smoke:rn:record": "node scripts/create-rn-smoke-record.js",
    "smoke:rn:finalize": "node scripts/finalize-smoke-record.js --target rn",
    "smoke:rn:results": "node scripts/create-smoke-results-template.js --target rn",
    "typecheck": "tsc --noEmit",
    "validate:docs-index": "node scripts/validate-docs-index.js",
    "validate:evaluation": "node scripts/validate-evaluation-config.js",
    "validate:h5-smoke": "node scripts/validate-h5-smoke-checklist.js",
    "validate:note-snapshot-routes": "node scripts/validate-note-snapshot-routes.js",
    "validate:rn-smoke": "node scripts/validate-rn-smoke-checklist.js",
    "validate:smoke-results": "node scripts/validate-smoke-results.js",
    "test:evaluation": "node scripts/test-evaluation-scoring.js",
    "test:evaluation-draft": "node scripts/test-evaluation-draft.js",
    "test:evaluation-validation": "node scripts/test-evaluation-validation.js",
    "test:h5-smoke-runner": "node scripts/test-h5-smoke-runner.js",
    "test:h5-size-analyze": "node scripts/test-h5-size-analyze.js",
    "test:h5-size-compare": "node scripts/test-h5-size-compare.js",
    "test:image-library-normalization": "node scripts/test-image-library-normalization.js",
    "test:note-normalization": "node scripts/test-note-normalization.js",
    "test:note-snapshot": "node scripts/test-note-snapshot.js",
    "test:note-snapshot-service": "node scripts/test-note-snapshot-service.js",
    "test:page-matrix": "node scripts/test-page-matrix.js",
    "test:smoke-records": "node scripts/test-smoke-record-generators.js",
    "test:submission-normalization": "node scripts/test-submission-normalization.js",
    "test:upload-normalization": "node scripts/test-upload-normalization.js"
  },
  "dependencies": {
    "@babel/runtime": "^7.24.8",
    "@tarojs/components": "3.6.38",
    "@tarojs/helper": "3.6.38",
    "@tarojs/plugin-framework-react": "3.6.38",
    "@tarojs/react": "3.6.38",
    "@tarojs/runtime": "3.6.38",
    "@tarojs/runtime-rn": "3.6.38",
    "@tarojs/shared": "3.6.38",
    "@tarojs/taro": "3.6.38",
    "@tarojs/taro-rn": "3.6.38",
    "@tarojs/components-rn": "3.6.38",
    "expo": "47.0.14",
    "react": "18.1.0",
    "react-dom": "18.1.0",
    "react-native": "0.70.15",
    "react-native-svg": "13.7.0",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@babel/core": "^7.24.8",
    "@pmmmwh/react-refresh-webpack-plugin": "^0.5.15",
    "@tarojs/cli": "3.6.38",
    "@tarojs/plugin-platform-h5": "3.6.38",
    "@tarojs/plugin-platform-weapp": "3.6.38",
    "@tarojs/rn-runner": "3.6.38",
    "@tarojs/rn-supporter": "3.6.38",
    "@tarojs/taro-loader": "3.6.38",
    "@tarojs/webpack5-runner": "3.6.38",
    "@types/node": "^20.14.10",
    "@types/react": "^18.2.79",
    "@types/react-dom": "^18.2.25",
    "babel-preset-taro": "3.6.38",
    "eslint-config-taro": "3.6.38",
    "react-refresh": "^0.14.2",
    "sass": "^1.77.6",
    "typescript": "^5.4.5",
    "webpack": "5.78.0"
  },
  "browserslist": [
    "last 3 versions",
    "Android >= 5",
    "iOS >= 9"
  ],
  "overrides": {
    "@ant-design/react-native": "5.0.0",
    "react-native": "0.70.15",
    "react-native-maps": "1.3.2",
    "react-native-svg": "13.7.0"
  }
}
